{
  "name": "gayatama",
  "version": "0.1.0",
  "private": true,
  "description": "Data-driven micro-business location scoring for Indonesia, built on open data.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace @gayatama/web",
    "dev:api": "npm run dev --workspace @gayatama/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
