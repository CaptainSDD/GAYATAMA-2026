# ===========================================================================
# GAYATAMA — environment template
# Copy to .env and fill in. Never commit the filled-in file.
#   cp .env.example .env
# ===========================================================================

# --- apps/api (NestJS) -----------------------------------------------------
PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Geoapify Places API (POI data) ----------------------------------------
# Primary POI source. Set the key and facility lookups go to Geoapify; leave it
# empty and the API falls back to Overpass. Server-side only: never expose this
# key to the browser (no VITE_ prefix).
# Free plan: 3,000 credits/day, 1 credit per 20 places returned.
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com/v2
GEOAPIFY_GEOCODING_BASE_URL=https://api.geoapify.com/v1
GEOAPIFY_TIMEOUT_MS=20000

# Cap on places fetched per POI cell (paged 500 at a time).
GEOAPIFY_MAX_PLACES=1000

# --- Groq LLM Narratives (optional) ----------------------------------------
# Used by apps/api to turn deterministic scores into plain-language summaries.
# Leave GROQ_API_KEY empty and the API uses the built-in hardcoded narrative.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_MS=8000

# --- Overpass API (OpenStreetMap site data) --------------------------------
# Still used for conditions at the site itself (roads, sidewalks, crossings,
# waterways, industrial land use), and as the POI fallback without a Geoapify
# key. Public instances are rate-limited and sometimes unreachable.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Tried in order when the primary instance is overloaded or unreachable.
OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
# Per-instance limit. Lower values fail over faster; 15000-30000 is practical
# for local development, while complex or self-hosted queries may need longer.
OVERPASS_TIMEOUT_MS=30000
# Hard deadline shared by the primary and all fallbacks.
OVERPASS_TOTAL_TIMEOUT_MS=8000

# How long a cached POI query stays fresh, in seconds (default 7 days).
POI_CACHE_TTL_SECONDS=604800

# --- Firebase Admin (apps/api) ---------------------------------------------
# Used for Firestore (POI cache, Google place-count cache, and saved reports).
# Locally: point GOOGLE_APPLICATION_CREDENTIALS at a service account JSON file
# that lives OUTSIDE this repository.
# In production: prefer the inlined key below, stored as a secret.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Alternative to the file above — paste the whole service account JSON on one
# line. Set this as a deployment secret, never in a committed file.
FIREBASE_SERVICE_ACCOUNT_JSON=


# --- Google Maps & Places API ----------------------------------------------
# Used by apps/api for server-side place lookups.
GOOGLE_PLACES_API_KEY=
# A Google timeout is non-fatal: the analysis falls back to OpenStreetMap.
GOOGLE_PLACES_TIMEOUT_MS=10000

# Exposed to the browser via Vite for the interactive map component.
VITE_GOOGLE_MAPS_API_KEY=

# --- SMTP, for the account verification email ------------------------------
# Leave SMTP_HOST or MAIL_FROM empty and the API reports that it cannot send;
# the browser then falls back to Firebase's own sender, so verification keeps
# working either way. Set both and the email comes from us instead: our wording,
# our From address, and a server-side log when a relay rejects it.
#
# Gmail needs an App Password (not the account password), with 2FA enabled:
#   SMTP_HOST=smtp.gmail.com / SMTP_PORT=587 / SMTP_USER=you@gmail.com
# For local testing without sending anything real, Mailpit or Mailhog on
# localhost:1025 works with no credentials at all.
SMTP_HOST=
SMTP_PORT=587
# true only for implicit TLS on port 465; port 587 upgrades via STARTTLS.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# The From header, e.g. LOKABIS <no-reply@lokabis.id>. Required to send.
MAIL_FROM=

# Where the verification link sends the visitor once Firebase has marked the
# address verified. The domain must be listed under Authentication → Settings →
# Authorized domains in the Firebase console, or Firebase refuses to mint the
# link. localhost is authorised by default.
APP_PUBLIC_URL=http://localhost:5173

# --- Firebase Web SDK (apps/web) -------------------------------------------
# Used for Firebase Authentication (login/sign-up) as well as identifying the
# project. These are public by design (they identify, they do not authorise —
# access is controlled by Firestore security rules and by Authentication's own
# sign-in method gate). Vite only exposes VITE_* to the browser bundle.
VITE_API_BASE_URL=http://localhost:3000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
