{
  "name": "@gayatama/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API — fetches OpenStreetMap POIs via Overpass, caches them in Firestore, and runs the scoring engine.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "osm:snapshots": "ts-node scripts/build-osm-snapshots.ts",
    "overture:places": "ts-node scripts/build-overture-places.ts"
  },
  "dependencies": {
    "@gayatama/scoring": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "firebase-admin": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": ["<rootDir>/test"],
    "testRegex": "\\.spec\\.ts$",
    "moduleFileExtensions": ["ts", "js", "json"],
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
    }
  }
}
