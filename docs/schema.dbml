// ==========================================================
// GAYATAMA — Relational schema, corrected against docs/methodology.md
// and packages/scoring/src (types.ts, constants.ts, recommend.ts,
// location-score.ts, confidence.ts) as of commit 9b31429.
//
// POI/fasilitas tetap di Firestore (poiCache), direferensi via poi_id
// string — lihat docs/architecture.md "Data model (Firestore)".
//
// Kotak "Note" di bawah ini SENGAJA dibuat berdiri sendiri (bukan
// komentar //) supaya ikut kegambar di kanvas dbdiagram.io dan kefoto
// kalau di-export/screenshot jadi PNG. Setelah paste ke dbdiagram.io,
// geser tiap kotak Note ke dekat tabel yang dibahasnya.
// ==========================================================

Note PERUBAHAN_1_recommendation_run {
  '''
  PERUBAHAN 1 — recommendation_run
  score_student..score_general, confidence_score, margin, config_snapshot,
  model_version, fetched_at DIPINDAH ke sini dari `analysis`.
  Alasan: methodology.md — 6 skor segmen & Confidence Score dihitung SEKALI
  PER LOKASI, bukan per kategori usaha. Dikonfirmasi di kode:
  recommend.ts baris 53-65 — confidence & segmentScores() dihitung sekali,
  dipakai ulang untuk ketujuh businessType.
  '''
}

Note PERUBAHAN_2_run_warning {
  '''
  PERUBAHAN 2 — run_warning (tabel baru)
  code cuma boleh "flood_risk_proxy" atau "stale_data" — types.ts
  WarningCode cuma punya 2 nilai ini. Zonasi & akses legal BUKAN warning
  otomatis (methodology.md: "no data source yet... reports list them as
  field checks") — teks checklist statis, tidak perlu disimpan per-run.
  '''
}

Note PERUBAHAN_3_analysis_rank {
  '''
  PERUBAHAN 3 — analysis.equivalence_group
  Menggantikan rank_in_recommendation (int). methodology.md §2: kategori
  dengan selisih skor ≤3 poin "treated as effectively equivalent" — sistem
  SENGAJA menolak beri urutan pasti. Kolom integer rank bertentangan
  langsung dengan aturan ini.
  '''
}

Note PERUBAHAN_4_analysis_competition {
  '''
  PERUBAHAN 4 — analysis (kolom Competitor Analysis ditambah)
  raw_competitor_count, equivalent_count, competitor_radius_meters,
  density, saturation_ratio, saturation_reading — BARU. Sebelumnya tidak
  ada kolomnya sama sekali, padahal ini isi utama Fitur 3.
  '''
}

Note PERUBAHAN_5_analysis_competitor {
  '''
  PERUBAHAN 5 — analysis_competitor (3 kolom ditambah)
  operating_hours_factor, competitor_scale, distance_weight ditambahkan.
  methodology.md §3: K = Σ(DistanceWeight × AccessFactor × DataQuality ×
  OperatingHoursFactor × Similarity × CompetitorScale) — 6 faktor.
  Versi lama cuma simpan 3, contribution_k tidak bisa direkonstruksi ulang.
  '''
}

Note PERUBAHAN_6_simulation {
  '''
  PERUBAHAN 6 — simulation
  parameter_changed (varchar tunggal) → parameters (jsonb).
  "rent" SENGAJA bukan key yang valid — methodology.md §5: "Change rent:
  Does not affect the Location Potential Score." Satu baris sekarang bisa
  menyimpan beberapa parameter sekaligus. delivery_cap_applied ditambah
  untuk mencatat cap +5 poin pada delivery.
  '''
}

Note PERUBAHAN_7_arsitektur {
  '''
  CATATAN ARSITEKTUR (bukan dari methodology.md)
  Tabel `user` masih ada tapi docs/roadmap.md bilang submission ini TANPA
  akun, dan endpoint apps/api/src/analysis/* saat ini publik tanpa auth.
  Perlu keputusan tim terpisah: pakai auth beneran, atau hapus semua
  created_by/user_id dari skema ini.
  '''
}

Table scoring_config {
  id uuid [pk, default: `gen_random_uuid()`]
  version_label varchar [unique, not null] // cth "0.1.0" — cocok MODEL_VERSION di constants.ts
  config_json jsonb [not null]             // zone weights, T values, dst
  is_active boolean [not null, default: false]
  created_at timestamp [default: `now()`]
}

Table user {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar
  email varchar [unique, not null]
  password_hash varchar
  created_at timestamp [default: `now()`]
}

Table business_category {
  slug varchar [pk] // beverages | food | laundry | stationery | minimarket | salon | pharmacy
  name varchar [not null]
  description text
  created_at timestamp [default: `now()`]
}

Table location {
  id uuid [pk, default: `gen_random_uuid()`]
  latitude decimal(9,6) [not null]
  longitude decimal(10,6) [not null]
  address_label varchar
  created_by uuid [not null, ref: > user.id]
  created_at timestamp [default: `now()`]
}

Table recommendation_run {
  id uuid [pk, default: `gen_random_uuid()`]
  location_id uuid [not null, ref: > location.id]

  model_version varchar [not null, ref: > scoring_config.version_label]
  config_snapshot jsonb [not null]

  score_student decimal
  score_office decimal
  score_resident decimal
  score_commuter decimal
  score_health decimal
  score_general decimal

  confidence_score decimal [not null]
  margin decimal [not null]

  fetched_at timestamp [not null]

  created_by uuid [not null, ref: > user.id]
  created_at timestamp [default: `now()`]
}

Table run_warning {
  id uuid [pk, default: `gen_random_uuid()`]
  recommendation_run_id uuid [not null, ref: > recommendation_run.id]
  code varchar [not null] // flood_risk_proxy | stale_data
  created_at timestamp [default: `now()`]
}

Table analysis {
  id uuid [pk, default: `gen_random_uuid()`]
  recommendation_run_id uuid [not null, ref: > recommendation_run.id]
  business_category_slug varchar [not null, ref: > business_category.slug]

  score_demand_fit decimal [not null]
  score_accessibility decimal [not null]
  score_competition decimal [not null]
  score_supporting_facility decimal [not null]
  score_risk decimal [not null]
  location_score decimal [not null]

  dominant_segment varchar [not null] // student|office|resident|commuter|health|general

  raw_competitor_count int [not null]
  equivalent_count decimal [not null]
  competitor_radius_meters int [not null]
  density varchar [not null]
  saturation_ratio decimal [not null]
  saturation_reading varchar [not null]

  status varchar [not null] // primary|alternative|needs_validation|not_recommended
  equivalence_group uuid

  detail_json jsonb
  created_at timestamp [default: `now()`]

  indexes {
    (recommendation_run_id, business_category_slug) [unique]
  }
}

Table analysis_competitor {
  id uuid [pk, default: `gen_random_uuid()`]
  analysis_id uuid [not null, ref: > analysis.id]
  poi_id varchar [not null]
  name varchar
  lat decimal(9,6)
  lng decimal(10,6)
  distance_meters decimal [not null]
  zone varchar [not null] // a | b | c

  distance_weight decimal [not null]
  access_factor decimal [not null]
  data_quality_factor decimal [not null]
  operating_hours_factor decimal [not null]
  similarity_level decimal [not null]
  competitor_scale decimal [not null]
  contribution_k decimal [not null]

  created_at timestamp [default: `now()`]
}

Table simulation {
  id uuid [pk, default: `gen_random_uuid()`]
  base_analysis_id uuid [not null, ref: > analysis.id]

  parameters jsonb [not null]

  resulting_location_score decimal [not null]
  resulting_confidence decimal [not null]
  delivery_cap_applied boolean

  created_by uuid [not null, ref: > user.id]
  created_at timestamp [default: `now()`]
}
